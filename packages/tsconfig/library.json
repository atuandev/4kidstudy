{
  "$schema": "https://json.schemastore.org/tsconfig",
  "display": "Internal TypeScript library consumed as source",
  "extends": "./base.json",
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["es2022"],
    "module": "esnext",
    "moduleResolution": "bundler",
    "strict": true,
    "noEmit": true,
    "incremental": false
  }
}
