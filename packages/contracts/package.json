{
  "name": "@4kidstudy/contracts",
  "version": "0.0.0",
  "private": true,
  "description": "API contract shared by apps/api and apps/web. Generated from the Prisma schema and the API's OpenAPI document; do not edit src/generated by hand.",
  "type": "module",
  "sideEffects": false,
  "exports": {
    ".": "./src/index.ts"
  },
  "scripts": {
    "generate": "node scripts/generate.mjs",
    "typecheck": "tsc --noEmit",
    "lint": "oxlint --type-aware",
    "format": "oxfmt",
    "format:check": "oxfmt --check"
  },
  "devDependencies": {
    "@4kidstudy/tsconfig": "workspace:*",
    "@types/node": "catalog:",
    "openapi-typescript": "7.13.0",
    "oxfmt": "0.79.0",
    "oxlint": "1.94.0",
    "oxlint-tsgolint": "7.0.2007",
    "typescript": "catalog:"
  }
}
