{
  "$schema": "./node_modules/oxfmt/configuration_schema.json",
  "printWidth": 100,
  "semi": true,
  "singleQuote": false,
  "trailingComma": "all",
  "sortImports": false,
  "sortTailwindcss": false,
  "sortPackageJson": false,
  // shadcn/ui components are generated by the shadcn CLI; keep them as generated.
  "ignorePatterns": ["components/ui/**", ".next/**", "next-env.d.ts", "public/**"]
}
