{
  "$schema": "./node_modules/oxlint/configuration_schema.json",
  // Mirrors the previous ESLint setup: eslint recommended +
  // typescript-eslint recommendedTypeChecked. Run with --type-aware.
  "plugins": ["typescript", "oxc", "unicorn", "import", "jest"],
  "jsPlugins": ["../../tools/oxlint/no-comments.mjs"],
  "env": { "node": true, "jest": true, "es2024": true },
  "categories": {
    "correctness": "error"
  },
  "rules": {
    "no-comments/no-comments": "error",

    // typescript-eslint recommended
    "typescript/ban-ts-comment": "error",
    "typescript/no-empty-object-type": ["error", { "allowInterfaces": "with-single-extends" }],
    "typescript/no-namespace": ["error", { "allowDeclarations": true }],
    "typescript/no-require-imports": "error",
    "typescript/no-unsafe-function-type": "error",
    "typescript/no-wrapper-object-types": "error",
    "typescript/prefer-namespace-keyword": "error",
    "typescript/no-unused-vars": "error",
    "no-unused-vars": "error",
    "no-useless-escape": "error",
    "prefer-const": "error",

    // typescript-eslint recommendedTypeChecked (type-aware)
    "typescript/await-thenable": "error",
    "typescript/no-array-delete": "error",
    "typescript/no-base-to-string": "error",
    "typescript/no-duplicate-type-constituents": "error",
    "typescript/no-floating-promises": "warn",
    "typescript/no-for-in-array": "error",
    "typescript/no-implied-eval": "error",
    "typescript/no-misused-promises": "error",
    "typescript/no-redundant-type-constituents": "error",
    "typescript/no-unnecessary-type-assertion": "error",
    "typescript/no-unsafe-argument": "warn",
    "typescript/no-unsafe-assignment": "warn",
    "typescript/no-unsafe-call": "off",
    "typescript/no-unsafe-enum-comparison": "error",
    "typescript/no-unsafe-member-access": "warn",
    "typescript/no-unsafe-return": "error",
    "typescript/no-unsafe-unary-minus": "error",
    "typescript/only-throw-error": "error",
    "typescript/prefer-promise-reject-errors": "error",
    "typescript/require-await": "error",
    "typescript/restrict-plus-operands": "error",
    "typescript/restrict-template-expressions": "error",
    "typescript/unbound-method": "error",

    // Project overrides (unchanged)
    "typescript/no-explicit-any": "off",
    // Not in the old ESLint set. DTOs are plain data classes, so spreading them
    // into Prisma `data` is intended.
    "typescript/no-misused-spread": "off"
  },
  "overrides": [
    {
      // expect(service.method).toHaveBeenCalled() is the normal Jest pattern.
      "files": ["**/*.spec.ts", "test/**/*.ts"],
      "rules": { "typescript/unbound-method": "off" }
    }
  ],
  "ignorePatterns": ["dist/**", "coverage/**", "node_modules/**"]
}
