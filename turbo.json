{
  "$schema": "https://turborepo.com/schema.json",
  "ui": "stream",
  "globalDependencies": [".nvmrc", "pnpm-workspace.yaml"],
  "globalPassThroughEnv": ["CI", "VERCEL", "VERCEL_*"],
  "tasks": {
    "db:generate": {
      "inputs": ["prisma/schema.prisma"],
      "cache": false
    },
    "build": {
      "dependsOn": ["^build", "db:generate"],
      "outputs": ["dist/**", ".next/**", "!.next/cache/**"],
      "env": ["NODE_ENV", "NEXT_PUBLIC_*", "CLOUDINARY_*"]
    },
    "typecheck": {
      "dependsOn": ["^build", "db:generate"]
    },
    "lint": {
      "dependsOn": ["^build", "db:generate"]
    },
    "test": {
      "dependsOn": ["db:generate"],
      "outputs": ["coverage/**"]
    },
    "dev": {
      "dependsOn": ["db:generate"],
      "cache": false,
      "persistent": true
    },
    "@4kidstudy/contracts#generate": {
      "dependsOn": ["@4kidstudy/api#build"],
      "inputs": ["scripts/**", "$TURBO_ROOT$/apps/api/prisma/schema.prisma"],
      "outputs": ["src/generated/**", "openapi.json"]
    }
  }
}
