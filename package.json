{
  "name": "4kidstudy",
  "private": true,
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "turbo run build",
    "dev": "turbo run dev",
    "lint": "turbo run lint",
    "format": "turbo run format",
    "format:check": "turbo run format:check",
    "typecheck": "turbo run typecheck",
    "test": "turbo run test",
    "contracts:generate": "turbo run generate --filter=@4kidstudy/contracts",
    "comments:list": "node tools/oxlint/comments.mjs list",
    "comments:baseline": "node tools/oxlint/comments.mjs baseline"
  },
  "devDependencies": {
    "turbo": "2.11.11"
  }
}
